# macOS
.DS_Store

# 依赖
node_modules/

# 构建产物
dist/
build/

# 编辑器本地配置（个人偏好，不提交）
.vscode/

# 日志
*.log

# 测试覆盖率
coverage/

# 测试缓存
.vitest/

# 工作目录标记与本地运行状态（首次创作时由 CLI 写入，每台机器各自生成）
.writing-agent/

# 运行产物
articles/
outlines/

# pi 会话本地状态
.pi/

# 本地环境变量（含真实模型密钥，不提交）
.env.local
.env

# 本地写作风格包（真人语气正文不进 git）
# 仓内只提交 styles/README.md 与无私人语气的 styles/_example/
styles/*
!styles/README.md
!styles/_example/
!styles/_example/**

# 误拷进工作树的风格指南全文副本
**/style-guide*.md
