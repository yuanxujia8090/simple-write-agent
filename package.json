{
  "name": "writing-agent",
  "version": "0.0.0",
  "private": true,
  "description": "本地运行的公众号长文写作 Agent（命令行）",
  "type": "module",
  "bin": {
    "writing-agent": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "exp:t0": "tsx experiments/t0/run.ts"
  },
  "dependencies": {
    "@langchain/langgraph": "1.5.3",
    "@langchain/langgraph-checkpoint-sqlite": "1.1.0",
    "better-sqlite3": "12.10.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.18.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
