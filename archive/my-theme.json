{
  "version": 1,
  "name": "橙色",
  "editorMode": "visual",
  "designerVariables": {
    "fontFamily": "-apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Helvetica Neue', Helvetica, Arial, sans-serif",
    "fontSize": "16px",
    "primaryColor": "#EF7534",
    "lineHeight": "1.7",
    "pagePadding": 8,
    "baseLetterSpacing": 0,
    "h1": {
      "fontSize": 24,
      "color": "#EF7534",
      "marginTop": 40,
      "marginBottom": 30,
      "centered": false,
      "fontWeight": "bold",
      "letterSpacing": 0
    },
    "h2": {
      "fontSize": 20,
      "color": "#EF7534",
      "marginTop": 30,
      "marginBottom": 20,
      "centered": false,
      "fontWeight": "bold",
      "letterSpacing": 0
    },
    "h3": {
      "fontSize": 18,
      "color": "#EF7534",
      "marginTop": 25,
      "marginBottom": 15,
      "centered": false,
      "fontWeight": "bold",
      "letterSpacing": 0
    },
    "h4": {
      "fontSize": 16,
      "color": "#EF7534",
      "marginTop": 20,
      "marginBottom": 10,
      "centered": false,
      "fontWeight": "bold",
      "letterSpacing": 0
    },
    "paragraphMargin": 16,
    "paragraphPadding": 0,
    "paragraphColor": "#333",
    "textIndent": false,
    "textJustify": true,
    "quoteBackground": "#f5f5f5",
    "quoteBorderColor": "#f59e0b",
    "quoteTextColor": "#666",
    "quotePreset": "left-border",
    "quoteBorderStyle": "solid",
    "quoteBorderWidth": 4,
    "quotePaddingX": 16,
    "quotePaddingY": 12,
    "quoteFontSize": 16,
    "quoteLineHeight": 1.6,
    "quoteTextCentered": false,
    "codeBackground": "#f5f5f5",
    "codeFontSize": 13,
    "inlineCodeColor": "#EF7534",
    "inlineCodeBackground": "#f9f2f4",
    "inlineCodeStyle": "simple",
    "showMacBar": true,
    "codeTheme": "github",
    "imageMargin": 20,
    "imageBorderRadius": 4,
    "imageShadow": false,
    "imageCaptionColor": "#C05407",
    "imageCaptionFontSize": 14,
    "imageCaptionTextAlign": "center",
    "linkColor": "#EF7534",
    "linkUnderline": true,
    "italicColor": "#EF7534",
    "delColor": "#EF7534",
    "markBackground": "#ffe4e1",
    "markColor": "#EF7534",
    "underlineStyle": "solid",
    "underlineColor": "#EF7534",
    "strongStyle": "color",
    "strongColor": "#C05407",
    "tableHeaderBackground": "#f8f8f8",
    "tableHeaderColor": "inherit",
    "tableBorderColor": "#dfe2e5",
    "tableZebra": true,
    "hrColor": "#EF7534",
    "hrHeight": 1,
    "hrMargin": 20,
    "hrStyle": "solid",
    "ulStyle": "disc",
    "ulStyleL2": "circle",
    "olStyle": "decimal",
    "olStyleL2": "lower-alpha",
    "listSpacing": 4,
    "listMarkerColor": "#EF7534",
    "listMarkerColorL2": "#EF7534",
    "ulFontSize": "inherit",
    "olFontSize": "inherit",
    "footnoteColor": "#EF7534",
    "footnoteFontSize": 12,
    "footnoteHeader": "参考资料",
    "footnoteHeaderColor": "#EF7534",
    "footnoteHeaderStyle": "left-border",
    "calloutStyle": "default",
    "mermaidTheme": "base"
  }
}